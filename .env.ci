# CI Environment Configuration for MISJustice Alliance Firm
# Used by GitHub Actions for smoke testing
# These are non-production values for CI only

# =============================================================================
# Core Infrastructure
# =============================================================================

# PostgreSQL Database
POSTGRES_USER=mcas
POSTGRES_PASSWORD=mcas_test_password
POSTGRES_DB=mcas

# Redis Cache
REDIS_PASSWORD=redis_test_password

# MinIO Object Storage
MCAS_MINIO_ACCESS_KEY=minio_test_access
MCAS_MINIO_SECRET_KEY=minio_test_secret

# =============================================================================
# MCAS Service
# =============================================================================

MCAS_ENV=test
MCAS_SECRET_KEY=ci_test_secret_key_not_for_production
MCAS_DATABASE_URL=postgresql+asyncpg://mcas:mcas_test_password@postgres:5432/mcas
MCAS_REDIS_URL=redis://:redis_test_password@redis:6379/0
MCAS_MINIO_ENDPOINT=minio:9000
MCAS_LITELLM_URL=http://litellm:4000
MCAS_LITELLM_KEY=ci_litellm_key

# =============================================================================
# LiteLLM Proxy
# =============================================================================

LITELLM_MASTER_KEY=ci_litellm_master_key
LITELLM_DATABASE_URL=postgresql://mcas:mcas_test_password@postgres:5432/litellm
DEFAULT_MATTER_TIER=T3

# =============================================================================
# SearXNG
# =============================================================================

SEARXNG_SECRET=ci_searxng_secret

# =============================================================================
# n8n
# =============================================================================

N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_test_password
N8N_ENCRYPTION_KEY=n8n_test_encryption_key_32_chars_long

# =============================================================================
# Traefik / Domain Configuration (dummy values for CI)
# =============================================================================

MCAS_DOMAIN=mcas.localhost
SEARXNG_DOMAIN=search.localhost
LITELLM_DOMAIN=llm.localhost
N8N_DOMAIN=n8n.localhost
