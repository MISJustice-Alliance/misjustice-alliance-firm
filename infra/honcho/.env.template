# Copy to .env and keep this file unmodified in git.

# Host binding for Tailscale-only access
TAILSCALE_IP=100.64.0.10

# Core database and cache
DB_CONNECTION_URI=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# LLM providers required by Honcho
LLM_OPENAI_API_KEY=replace-me
LLM_ANTHROPIC_API_KEY=
LLM_GEMINI_API_KEY=

# Shared memory / auth
HONCHO_API_KEY=replace-me
HONCHO_WORKSPACE_ID=replace-me
HONCHO_MCP_URL=http://127.0.0.1:8000/mcp
AUTH_USE_AUTH=true
AUTH_JWT_SECRET=replace-me

# Optional tuning
LOG_LEVEL=INFO
COLLECT_METRICS_LOCAL=true
LOCAL_METRICS_FILE=/var/lib/honcho/metrics.jsonl
REASONING_TRACES_FILE=/var/lib/honcho/traces.jsonl
EMBED_MESSAGES=true
VECTOR_STORE_TYPE=pgvector
