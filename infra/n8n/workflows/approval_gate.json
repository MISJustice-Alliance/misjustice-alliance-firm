{
  "name": "MISJustice Approval Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approval-gate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Approval Gate Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "approval-gate"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nreturn {\n  json: {\n    approval_id: body.approval_id,\n    matter_id: body.matter_id,\n    matter_display_id: body.matter_display_id || '',\n    matter_title: body.matter_title || '',\n    gate_type: body.gate_type,\n    summary: body.summary,\n    requested_by: body.requested_by,\n    deadline: body.deadline || '',\n    review_url: `${process.env.MISJUSTICE_PORTAL_URL || 'http://localhost:5173'}/approvals/${body.approval_id}`,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "format-request",
      "name": "Format Approval Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "message": "=**MISJustice Alliance — Approval Gate Request**\n\n**Matter:** {{ $json.matter_display_id }} — {{ $json.matter_title }}\n**Gate Type:** {{ $json.gate_type }}\n**Requested By:** {{ $json.requested_by }}\n**Deadline:** {{ $json.deadline || 'None' }}\n\n**Summary:**\n{{ $json.summary }}\n\nReview: {{ $json.review_url }}",
        "subject": "Approval Required: {{ $json.gate_type }} — {{ $json.matter_display_id }}",
        "toList": [
          "{{ process.env.MISJUSTICE_APPROVAL_EMAIL || 'legal-director@misjusticealliance.org' }}"
        ],
        "approvalOptions": {
          "values": [
            {
              "label": "✅ Approve",
              "value": "approved",
              "style": "primary"
            },
            {
              "label": "❌ Reject",
              "value": "rejected",
              "style": "danger"
            }
          ]
        },
        "options": {}
      },
      "id": "request-approval",
      "name": "Request Human Approval",
      "type": "n8n-nodes-base.email",
      "typeVersion": 2.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-approved",
              "leftValue": "={{ $json.approved }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "check-approval",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://mcas:8000/api/v1/approvals/{{ $json.approval_id }}/approve",
        "options": {}
      },
      "id": "confirm-approval",
      "name": "Confirm Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://mcas:8000/api/v1/approvals/{{ $json.approval_id }}/reject",
        "options": {}
      },
      "id": "reject-approval",
      "name": "Reject Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"processed\",\n  \"approval_id\": \"{{ $json.approval_id }}\",\n  \"decision\": \"{{ $json.approved ? 'approved' : 'rejected' }}\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Approval Gate Webhook": {
      "main": [
        [
          {
            "node": "Format Approval Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Approval Request": {
      "main": [
        [
          {
            "node": "Request Human Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Human Approval": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Confirm Approval",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm Approval": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reject Approval": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["misjustice", "approval", "hitl"]
}
