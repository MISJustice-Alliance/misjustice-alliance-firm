{
  "name": "MISJustice Draft Review Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "draft-review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Draft Review Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "draft-review"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nreturn {\n  json: {\n    matter_id: body.matter_id,\n    document_id: body.document_id,\n    matter_display_id: body.matter_display_id || '',\n    filename: body.filename || 'Unnamed document',\n    requested_by: body.requested_by || 'Unknown',\n    review_url: `${process.env.MISJUSTICE_PORTAL_URL || 'http://localhost:5173'}/matters/${body.matter_id}`,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "format",
      "name": "Format Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "message": "=**MISJustice Alliance — Draft Review Gate**\n\n**Matter:** {{ $json.matter_display_id }}\n**Document:** {{ $json.filename }}\n**Requested By:** {{ $json.requested_by }}\n\nReview: {{ $json.review_url }}",
        "subject": "Draft Review: {{ $json.filename }} — {{ $json.matter_display_id }}",
        "toList": [
          "{{ process.env.MISJUSTICE_APPROVAL_EMAIL || 'legal-director@misjusticealliance.org' }}"
        ],
        "approvalOptions": {
          "values": [
            {
              "label": "✅ Approve Draft",
              "value": "approved",
              "style": "primary"
            },
            {
              "label": "❌ Reject — Request Changes",
              "value": "rejected",
              "style": "danger"
            }
          ]
        },
        "options": {}
      },
      "id": "request-approval",
      "name": "Request Draft Approval",
      "type": "n8n-nodes-base.email",
      "typeVersion": 2.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-approved",
              "leftValue": "={{ $json.approved }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "check-approval",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://mcas:8000/api/v1/matters/{{ $json.matter_id }}/events",
        "body": "={\n  \"event_type\": \"REVIEW\",\n  \"description\": \"Draft {{ $json.filename }} approved for publication\",\n  \"metadata\": { \"document_id\": \"{{ $json.document_id }}\", \"decision\": \"approved\" }\n}",
        "options": {}
      },
      "id": "log-approved",
      "name": "Log Approved Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://mcas:8000/api/v1/matters/{{ $json.matter_id }}/events",
        "body": "={\n  \"event_type\": \"REVIEW\",\n  \"description\": \"Draft {{ $json.filename }} rejected — changes requested\",\n  \"metadata\": { \"document_id\": \"{{ $json.document_id }}\", \"decision\": \"rejected\" }\n}",
        "options": {}
      },
      "id": "log-rejected",
      "name": "Log Rejected Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"processed\",\n  \"document_id\": \"{{ $json.document_id }}\",\n  \"decision\": \"{{ $json.approved ? 'approved' : 'rejected' }}\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Draft Review Webhook": {
      "main": [
        [
          {
            "node": "Format Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Request": {
      "main": [
        [
          {
            "node": "Request Draft Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Draft Approval": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Log Approved Event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Rejected Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Approved Event": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Rejected Event": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["misjustice", "draft", "review"]
}
