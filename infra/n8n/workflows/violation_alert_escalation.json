{
  "name": "MISJustice Critical Violation Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "violation-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Violation Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "violation-alert"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nreturn {\n  json: {\n    alert_type: body.alert_type || 'CRITICAL_VIOLATION',\n    jurisdiction: body.jurisdiction,\n    facility: body.facility,\n    description: body.description,\n    source: body.source || 'monitoring',\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "format",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mcas:8000/api/v1/matters",
        "body": "={\n  \"title\": \"{{ $json.alert_type }} — {{ $json.facility }}\",\n  \"classification\": \"T1_PRIVILEGED\",\n  \"jurisdiction\": \"{{ $json.jurisdiction }}\"\n}",
        "options": {}
      },
      "id": "create-matter",
      "name": "Create Escalated Matter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ process.env.MISJUSTICE_ALERT_EMAIL || 'legal-director@misjusticealliance.org' }}",
        "subject": "🚨 CRITICAL: {{ $json.alert_type }} — {{ $json.facility }}",
        "text": "=CRITICAL VIOLATION ALERT\n\nType: {{ $json.alert_type }}\nFacility: {{ $json.facility }}\nJurisdiction: {{ $json.jurisdiction }}\n\nDescription:\n{{ $json.description }}\n\nEscalated matter created: {{ $json.matter_id || 'pending' }}\nTimestamp: {{ $json.timestamp }}",
        "options": {}
      },
      "id": "email",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"escalated\",\n  \"matter_id\": \"{{ $json.matter_id }}\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Violation Alert Webhook": {
      "main": [
        [
          {
            "node": "Format Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert": {
      "main": [
        [
          {
            "node": "Create Escalated Matter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Escalated Matter": {
      "main": [
        [
          {
            "node": "Send Alert Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Alert Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["misjustice", "alert", "escalation"]
}
