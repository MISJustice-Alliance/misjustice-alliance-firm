# =============================================================================
# MISJustice Alliance Firm - Environment Configuration
# Version: 2.0 (2026-05-08)
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# =============================================================================

# =============================================================================
# Core Infrastructure
# =============================================================================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=misjustice
POSTGRES_USER=misjustice
POSTGRES_PASSWORD=change_me_in_production

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET_NAME=misjustice-documents
MINIO_SECURE=false

# =============================================================================
# Research Intelligence Stack (v2)
# =============================================================================

# -----------------------------------------------------------------------------
# GPT Researcher + LangGraph Multi-Agent (Port: 8005)
# -----------------------------------------------------------------------------
GPTR_HOST=localhost
GPTR_PORT=8005
GPTR_API_KEY=change_me_in_production

# LLM Provider for GPT Researcher
GPTR_LLM_PROVIDER=openai
GPTR_LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your_openai_key_here

# Alternative: Anthropic
# GPTR_LLM_PROVIDER=anthropic
# GPTR_LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# LangGraph Configuration
LANGGRAPH_CHECKPOINT_DB=postgresql://misjustice:change_me@localhost:5432/langgraph
LANGGRAPH_DEBUG=false

# Research Depth (default: comprehensive)
# Options: quick, comprehensive, exhaustive
GPTR_RESEARCH_DEPTH=comprehensive

# Max iterations for research loops
GPTR_MAX_ITERATIONS=10

# -----------------------------------------------------------------------------
# gptr-mcp - Research MCP Bridge (Port: 4000)
# -----------------------------------------------------------------------------
GPTR_MCP_HOST=localhost
GPTR_MCP_PORT=4000
GPTR_MCP_API_KEY=change_me_in_production

# MCP Server Configuration
MCP_SERVER_NAME=gptr-mcp
MCP_TRANSPORT=stdio

# -----------------------------------------------------------------------------
# Tovana - Ephemeral Memory (Port: 8006)
# -----------------------------------------------------------------------------
TOVANA_HOST=localhost
TOVANA_PORT=8006
TOVANA_API_KEY=change_me_in_production

# Memory Tiers
TOVANA_PERSISTENT_TIER_ENABLED=true
TOVANA_EPHEMERAL_TTL=3600
TOVANA_IMPLICIT_EXTRACTION=true

# Storage Backend
TOVANA_STORAGE_TYPE=postgresql
TOVANA_DATABASE_URL=postgresql://misjustice:change_me@localhost:5432/tovana

# -----------------------------------------------------------------------------
# Morphic - Generative Search (Port: 3002)
# -----------------------------------------------------------------------------
MORPHIC_HOST=localhost
MORPHIC_PORT=3002

# Search Provider Chain (fallback order)
# Primary: SearXNG
MORPHIC_SEARXNG_URL=http://localhost:8080
MORPHIC_SEARXNG_API_KEY=change_me_in_production

# Fallback 1: Tavily
TAVILY_API_KEY=tvly-your_tavily_key_here

# Fallback 2: Brave Search
BRAVE_API_KEY=BS-your_brave_key_here

# Fallback 3: Exa
EXA_API_KEY=exa-your_exa_key_here

# LLM for answer synthesis
MORPHIC_LLM_PROVIDER=openai
MORPHIC_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Scrapling - Distributed Scraping (Port: 5000)
# -----------------------------------------------------------------------------
SCRAPLING_HOST=localhost
SCRAPLING_PORT=5000
SCRAPLING_API_KEY=change_me_in_production

# Scraping Configuration
SCRAPLING_MAX_WORKERS=10
SCRAPLING_RATE_LIMIT_RPS=5
SCRAPLING_TIMEOUT_SECONDS=30
SCRAPLING_RETRY_ATTEMPTS=3

# Proxy Configuration (optional)
# SCRAPLING_PROXY_URL=http://proxy.example.com:8080
# SCRAPLING_PROXY_USERNAME=username
# SCRAPLING_PROXY_PASSWORD=password

# =============================================================================
# Legacy Components (Deprecated in v2)
# =============================================================================

# These components are deprecated but kept for backward compatibility
# during migration. See SPEC.md §12 for migration details.

# Vane (deprecated, replaced by Morphic)
# VANE_HOST=localhost
# VANE_PORT=3001
# VANE_SEARXNG_API_URL=http://localhost:8080

# LawGlance (deprecated, replaced by GPT Researcher + gptr-mcp)
# LAWGLANCE_HOST=localhost
# LAWGLANCE_PORT=8003

# Legal Source Gateway (deprecated, replaced by gptr-mcp)
# LEGAL_SOURCE_GATEWAY_HOST=localhost
# LEGAL_SOURCE_GATEWAY_PORT=8004

# AutoResearchClaw (deprecated, replaced by GPT Researcher)
# AUTORESEARCHCLAW_HOST=localhost
# AUTORESEARCHCLAW_PORT=8002

# =============================================================================
# Search Infrastructure
# =============================================================================

# SearXNG Private Instance
SEARXNG_HOST=localhost
SEARXNG_PORT=8080
SEARXNG_API_URL=http://localhost:8080

# Search Token Tiers (Private Token Model)
# T1-publicsafe: Sol, Quill, Mira, Webmaster, Social Media Manager
SEARXNG_T1_PUBLICSAFE_TOKEN=change_me_t1_publicsafe

# T1-internal: Avery, Rae, Ollie
SEARXNG_T1_INTERNAL_TOKEN=change_me_t1_internal

# T2-restricted: Lex, Casey
SEARXNG_T2_RESTRICTED_TOKEN=change_me_t2_restricted

# T3-pi: Iris
SEARXNG_T3_PI_TOKEN=change_me_t3_pi

# T4-admin: Humans only (via Morphic)
SEARXNG_T4_ADMIN_TOKEN=change_me_t4_admin

# =============================================================================
# Agent Memory (MemoryPalace)
# =============================================================================

MEMORY_PALACE_HOST=localhost
MEMORY_PALACE_PORT=8000
MEMORY_PALACE_API_KEY=change_me_in_production

# MCP Server Configuration
MEMORY_PALACE_MCP_SERVER_NAME=memorypalace
MEMORY_PALACE_MCP_TRANSPORT=stdio

# =============================================================================
# Case Management (MCAS)
# =============================================================================

MCAS_HOST=localhost
MCAS_PORT=8001
MCAS_API_KEY=change_me_in_production
MCAS_DATABASE_URL=postgresql://misjustice:change_me@localhost:5432/mcas

# =============================================================================
# Human Interface (Hermes)
# =============================================================================

HERMES_CONFIG_PATH=agents/hermes/agent.yaml
HERMES_OPENCLAW_ENDPOINT=http://localhost:9000
HERMES_MEMORY_PALACE_URL=http://localhost:8000

# =============================================================================
# Orchestration (OpenClaw / NemoClaw)
# =============================================================================

OPENCLAW_HOST=localhost
OPENCLAW_PORT=9000
OPENCLAW_API_KEY=change_me_in_production

NEMOCLAW_HOST=localhost
NEMOCLAW_PORT=9001
NEMOCLAW_API_KEY=change_me_in_production

# OpenShell Sandbox Configuration
OPENCLAW_SANDBOX_IMAGE=openshell/openclaw:latest
OPENCLAW_SANDBOX_POLICY_PATH=services/openshell/policies/openclaw_base.yaml

# =============================================================================
# HITL Workflow (Multica)
# =============================================================================

# Multica Inbox Configuration
MULTICA_HOST=localhost
MULTICA_PORT=5678
MULTICA_API_KEY=change_me_in_production

# n8n (deprecated, replaced by Multica)
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=change_me_in_production

# =============================================================================
# Communication Channels
# =============================================================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_guild_id

# AgenticMail
AGENTICMAIL_API_KEY=your_agenticmail_key
AGENTICMAIL_WEBHOOK_URL=https://api.agenticmail.com/v1/webhook

# =============================================================================
# External APIs
# =============================================================================

# Legal Data Sources
COURTLISTENER_TOKEN=your_courtlistener_token
GOVINFO_API_KEY=your_govinfo_api_key
OPEN_STATES_API_KEY=your_open_states_key
LEGISCAN_API_KEY=your_legiscan_key

# Web3 / Blockchain (if applicable)
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your_project_id
WEB3_PRIVATE_KEY=your_private_key

# =============================================================================
# Security & Privacy
# =============================================================================

# Encryption
ENCRYPTION_KEY=change_me_32_characters_long
JWT_SECRET=change_me_in_production_jwt_secret

# Data Classification
DEFAULT_DOCUMENT_TIER=T2
MAX_DOCUMENT_TIER=T0

# Audit Logging
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=2555

# =============================================================================
# Development / Debug
# =============================================================================

DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# Hot reload for development
HOT_RELOAD=false

# =============================================================================
# Feature Flags
# =============================================================================

# Enable v2 Research Intelligence Stack
FEATURE_RESEARCH_INTELLIGENCE_V2=true

# Disable legacy components
FEATURE_VANE=false
FEATURE_LAWGLANCE=false
FEATURE_LEGAL_SOURCE_GATEWAY=false
FEATURE_AUTORESEARCHCLAW=false
FEATURE_N8N=false

# Enable new components
FEATURE_MORPHIC=true
FEATURE_GPT_RESEARCHER=true
FEATURE_GPTR_MCP=true
FEATURE_TOVANA=true
FEATURE_SCRAPLING=true
FEATURE_MULTICA=true

# =============================================================================
# End of Configuration
# =============================================================================
